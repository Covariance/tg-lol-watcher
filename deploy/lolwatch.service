[Unit]
Description=LoL Telegram tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lolwatch
WorkingDirectory=/opt/lolwatch
EnvironmentFile=/etc/lolwatch/env
# uv needs writable cache + Python dirs under ProtectSystem=strict; /opt/lolwatch is writable below.
Environment=UV_CACHE_DIR=/opt/lolwatch/.uv-cache
Environment=UV_PYTHON_INSTALL_DIR=/opt/lolwatch/.uv-python
# Absolute path: systemd has no useful PATH, and ~/.local/bin is invisible to this user.
ExecStartPre=/usr/local/bin/uv sync --frozen --no-dev
ExecStart=/usr/local/bin/uv run --frozen --no-dev python -m lolwatch
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/lolwatch

[Install]
WantedBy=multi-user.target
